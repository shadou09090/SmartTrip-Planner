# Configuración backend de OpenRouteService. No guardes una clave real en este archivo.
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org
ORS_CONNECT_TIMEOUT_MS=3000
ORS_READ_TIMEOUT_MS=12000

# Geoapify Places (la clave se mantiene solo en el backend). Plan gratuito sujeto a cuota y atribución.
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_CONNECT_TIMEOUT_MS=3000
GEOAPIFY_READ_TIMEOUT_MS=10000

# Geoapify is the current Places provider; keep its API key private in the backend environment.
# Geoapify free quota and attribution terms apply; check current provider terms before deployment.

# Legacy Overpass configuration is retained for explicit/manual use only; it is not an automatic fallback.
# Do not enable it as a secondary source unless connectivity and the instance's current usage policy are verified.
SMARTTRIP_OVERPASS_URL=https://overpass-api.de/api/interpreter
SMARTTRIP_OVERPASS_ALTERNATES=https://overpass.private.coffee/api/interpreter
SMARTTRIP_PLACES_CONNECT_TIMEOUT_MS=3000
SMARTTRIP_PLACES_READ_TIMEOUT_MS=15000
SMARTTRIP_OVERPASS_ENDPOINT_COOLDOWN_SECONDS=180
SMARTTRIP_OVERPASS_DAILY_REQUEST_LIMIT=80

# Public Wikidata SPARQL source (no API key); requests are cached and rate-limited.
SMARTTRIP_WIKIDATA_ENABLED=true
SMARTTRIP_WIKIDATA_CONNECT_TIMEOUT_MS=3000
SMARTTRIP_WIKIDATA_READ_TIMEOUT_MS=10000

# Expose safe per-search counts in authenticated responses during local development only.
SMARTTRIP_RECOMMENDATION_DIAGNOSTICS=false

# Enable only after V20261116_01 has been reviewed and applied to the target database.
SMARTTRIP_PACKAGE_PERSISTENCE_ENABLED=false
